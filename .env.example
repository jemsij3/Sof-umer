# APP_URL: The URL where this applet is hosted.
APP_URL="https://sofumerapp.com"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens (JWT) for authentication.
JWT_SECRET="YOUR_SECURE_JWT_SECRET_HERE"

# MONGODB_URI: Connection string for your production MongoDB database (e.g., MongoDB Atlas).
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/sofumer?retryWrites=true&w=majority"

# CLOUDINARY CONFIGURATION (For Image Uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
