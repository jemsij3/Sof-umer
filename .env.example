# =================================================================
# SOF UMER MARKETPLACE - ENVIRONMENT CONFIGURATION (.env.example)
# =================================================================
# Copy these variables to your deployment environment (e.g., Render Environment Variables panel)

# -----------------------------------------------------------------
# 1. DATABASE & FILE STORAGE (CRITICAL FOR PRODUCTION PERSISTENCE)
# -----------------------------------------------------------------
# MONGODB_URI: Primary database connection string (MongoDB Atlas or Render Managed MongoDB).
# Supported fallbacks: MONGO_URL, DATABASE_URL
# MANDATORY FOR PRODUCTION: Stores all structured data (users, listings, FAQs, categories, transactions).
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sof_umer_db?retryWrites=true&w=majority

# -----------------------------------------------------------------
# 1B. CLOUDINARY FILE STORAGE (FOR USER PHOTOS & MEDIA ASSETS)
# -----------------------------------------------------------------
# When configured, user profile pictures, property photos, and banner images are uploaded 
# directly to Cloudinary, returning secure HTTPS URLs stored inside MongoDB Atlas.
# Prevents storing raw image bloat in MongoDB documents or local container storage.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# STORAGE_PATH / DATA_DIR: Secondary file storage directory fallback if MongoDB is not used.
# Required ONLY if using Render Persistent Disk without MongoDB.
# DATA_DIR=/data

# -----------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------
# JWT_SECRET: Secret key used to sign and verify user JWT authentication tokens.
# MANDATORY FOR PRODUCTION: Use a strong, random 32+ character string.
JWT_SECRET=your_production_jwt_secret_key_change_this_32chars

# NODE_ENV: Application environment mode ('production' or 'development').
# In production, dev verification codes are suppressed from API responses.
NODE_ENV=production

# -----------------------------------------------------------------
# 3. DOMAIN & APP URL
# -----------------------------------------------------------------
# APP_URL: Public production URL of your deployment (used for email links and callbacks).
APP_URL=https://sof-umer.onrender.com

# -----------------------------------------------------------------
# 4. EMAIL SERVICES (RESEND OR SMTP)
# -----------------------------------------------------------------
# RESEND_API_KEY: API key for Resend email delivery (https://resend.com)
RESEND_API_KEY=re_123456789_your_resend_api_key

# RESEND_FROM: Sender email address for Resend. Must be a verified domain in Resend.
RESEND_FROM="Sof Umer Marketplace <noreply@yourdomain.com>"

# --- SMTP ALTERNATIVE (Used if RESEND_API_KEY is omitted) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Sof Umer Marketplace <noreply@sofumer.com>"

# -----------------------------------------------------------------
# 5. AI SERVICES (OPTIONAL)
# -----------------------------------------------------------------
# GEMINI_API_KEY: Gemini AI API key for server-side AI features.
GEMINI_API_KEY=your_gemini_api_key
